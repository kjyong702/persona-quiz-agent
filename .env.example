# 이 파일을 .env로 복사해 쓴다. .env는 커밋하지 않는다.

DATABASE_URL=sqlite+aiosqlite:///./quiz.db
CHROMA_PATH=./.chroma

# --- 외부 API ---
# 없으면 시드가 앵커 임베딩을 건너뛰고, 답변 판정은 503으로 실패한다
OPENAI_API_KEY=

# 모델은 별칭이 아니라 날짜가 박힌 스냅샷으로 고정한다.
# 바꿀 때는 평가를 다시 돌리고, 임베딩 모델을 바꿨다면 앵커도 다시 적재한다
EMBEDDING_MODEL=text-embedding-3-small
JUDGE_MODEL=gpt-4o-mini-2024-07-18
LLM_TIMEOUT_SECONDS=20

# --- 판정 임계값 ---
# Phase 5 평가 전의 임시값이다. 아직 근거가 없다
UPPER_THRESHOLD=0.82
LOWER_THRESHOLD=0.55
MIN_MARGIN=0.05
