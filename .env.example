# 이 파일을 .env로 복사해 쓴다. .env는 커밋하지 않고 이미지에도 넣지 않는다.
# 컨테이너로 띄울 때는 환경변수나 시크릿 마운트로 주입한다.

DATABASE_URL=sqlite+aiosqlite:///./quiz.db
CHROMA_PATH=./.chroma

# 커넥션 풀. **이 값이 곧 동시 외부 호출 상한이 된다.**
# 요청 스코프 세션이 LLM 응답을 기다리는 내내 커넥션을 쥐고 있기 때문이다.
# 근거: docs/notes/concurrency.md
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

# --- 외부 API ---
# 없으면 시드가 앵커 임베딩을 건너뛰고 답변 판정이 503으로 실패한다.
# /readyz가 api_key=none으로 잡아낸다
OPENAI_API_KEY=

# 모델은 별칭이 아니라 날짜가 박힌 스냅샷으로 고정한다.
# 바꿀 때는 평가를 다시 돌린다. **임베딩 모델을 바꿨다면 앵커도 다시 적재해야 한다.**
# 안 하면 저장된 벡터와 질의 벡터가 다른 공간에 있게 되고 유사도가 조용히 망가진다
# (docs/notes/index-drift.md). 도장 검사가 막지만 서비스는 멈춘다
EMBEDDING_MODEL=text-embedding-3-small
JUDGE_MODEL=gpt-4o-mini-2024-07-18

# 호출 하나의 상한
LLM_TIMEOUT_SECONDS=20

# 요청 하나의 상한. **호출 단위 타임아웃만으로는 상한이 안 잡힌다.**
# 재시도 4회에 백오프가 붙어 판정 한 건이 최악 167초까지 간다.
# 앞단에 프록시를 둘 때는 이 값보다 **길게** 잡아야 앱이 먼저 끊는다
REQUEST_TIMEOUT_SECONDS=30

# 자격증명을 다시 읽는 주기. 키를 회전시켜도 프로세스가 모르면 소용이 없다
CREDENTIAL_TTL_SECONDS=300

# --- 판정 임계값 ---
# 라벨링 평가셋 372건의 실측 분포로 확정한 값이다.
# **둘 다 최적값이 아니라 여유를 얹은 값이다.** 최적값은 이 데이터에서만 오류 0이고
# 경계에 가장 가까운 샘플이 하나만 더 나와도 깨진다.
# 근거: docs/notes/threshold-measurement.md
# 재현: uv run python -m scripts.analyze --sweep --holdout
UPPER_THRESHOLD=0.92
LOWER_THRESHOLD=0.24

# --- 판정 안정성 ---
# 판정에만 시드를 건다. 멘트는 매번 달라야 하므로 안 건다.
# **시드는 결정성을 보장하지 않는다.** 실측에서 효과를 확인하지 못했다
# (docs/notes/determinism.md). 그래도 넣는 이유는 안 넣으면 제공사가 흔들림을
# 줄일 여지 자체가 없고 비용도 0이기 때문이다
JUDGE_SEED=20260803

# logprobs로 받은 correct 확률이 이 사이면 "흔들릴 자리"로 기록한다.
# 경계 19건을 20회씩 돌려 정한 값이다. 판정 결과는 바꾸지 않고 관측만 한다
UNSTABLE_LOW=0.02
UNSTABLE_HIGH=0.92

# --- 진행 멘트 ---
# 판정과 설정이 반대다. 판정은 재현성이 전부라 temperature 0이고,
# 멘트는 매번 같은 문장이면 진행자가 녹음기처럼 들려서 흔들림을 남긴다
HOST_TEMPERATURE=0.8
HOST_MAX_TOKENS=200

# --- 나가는 호출 흐름 제어 ---
# 부하 실험에서 대응 전후를 비교할 때 이 둘만 뒤집는다 (docs/notes/concurrency.md)
GATE_ENABLED=true
RETRY_ENABLED=true

# 실제 쿼터보다 낮게 잡아야 의미가 있다.
# 한도와 같게 두면 우리 쪽 계산 오차만큼 그대로 429가 난다
EMBEDDING_MAX_CONCURRENCY=8
EMBEDDING_RPM=2000
LLM_MAX_CONCURRENCY=4
LLM_RPM=300

RETRY_MAX_ATTEMPTS=4
RETRY_INITIAL_DELAY=0.5
RETRY_MAX_DELAY=20

# --- 로깅 ---
# 프로덕션은 JSON이어야 수집기가 파싱한다. 개발에서 읽기 힘들면 false로 끈다
LOG_JSON=true
LOG_LEVEL=INFO
